---
import { site, nav, whatsappLink } from '../data/site.js';
const { pathname } = Astro.url;
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="mark" aria-label={`${site.doctorName} — Inicio`}>
      <img src="/images/logo.png" alt={site.doctorName} width="640" height="422" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Navegación principal">
      <div class="site-nav__inner">
      <div class="site-nav__links">
        {nav.map((item) => (
          item.children ? (
            <details class="dropdown" name="main-nav">
              <summary
                class={pathname === item.href || pathname.startsWith(item.href + '/') || pathname.startsWith(item.href + '#') ? 'active' : ''}
              >
                {item.label}
              </summary>
              <ul class="dropdown-panel">
                {item.children.map((child) => (
                  <li><a href={child.href}>{child.label}</a></li>
                ))}
              </ul>
            </details>
          ) : (
            <a
              href={item.href}
              class={pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href)) ? 'active' : ''}
            >
              {item.label}
            </a>
          )
        ))}
      </div>

      <a class="site-nav__cta" href={whatsappLink('Hola, quisiera agendar una cita.')} target="_blank" rel="noopener">
        <svg viewBox="0 0 32 32" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d="M16 3C9.4 3 4 8.4 4 15c0 2.4.7 4.6 1.9 6.5L4 29l7.7-2c1.8 1 3.9 1.5 6.3 1.5 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-2.1 0-4.1-.6-5.8-1.6l-.4-.2-4.6 1.2 1.2-4.5-.3-.5C4.9 17.7 4.2 16.4 4.2 15 4.2 9.5 9.5 5.2 16 5.2S27.8 9.5 27.8 15 22.5 24.8 16 24.8zm6.1-8.2c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.7.2s-.8 1.1-1 1.3c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-2-1.8-2.3-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.6-.7 1.9-1.3.2-.6.2-1.1.2-1.3-.1-.1-.3-.2-.6-.3z"/>
        </svg>
        Agendar cita
      </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Cierra los desplegables del menú al hacer clic fuera o con Escape,
  // y añade sombra al header cuando hay scroll.
  document.addEventListener('click', (event) => {
    document.querySelectorAll('.site-nav details[open]').forEach((el) => {
      if (!(el as HTMLElement).contains(event.target as Node)) {
        el.removeAttribute('open');
      }
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      document.querySelectorAll('.site-nav details[open]').forEach((el) => el.removeAttribute('open'));
    }
  });

  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menú móvil: bloquea el scroll del fondo mientras está abierto,
  // y lo cierra al elegir un enlace o con Escape.
  const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
  const lockScroll = (locked: boolean) => {
    document.documentElement.style.overflow = locked ? 'hidden' : '';
  };
  toggle?.addEventListener('change', () => lockScroll(toggle.checked));
  document.querySelectorAll('.site-nav__links > a').forEach((a) =>
    a.addEventListener('click', () => { if (toggle) { toggle.checked = false; lockScroll(false); } })
  );
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.checked) { toggle.checked = false; lockScroll(false); }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    /* Fondo sólido (sin backdrop-filter): el blur hacía que el menú de pantalla
       completa calculara "fixed" respecto al header en vez de respecto a toda
       la pantalla, por un comportamiento del estándar de CSS poco conocido. */
    background: rgba(251, 253, 253, 0.97);
    border-bottom: 1px solid transparent;
    transition: border-color 220ms ease, box-shadow 220ms ease;
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 8px 24px -18px rgba(41, 38, 91, 0.35);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    padding-bottom: 8px;
    position: relative;
    z-index: 56; /* por encima del menú móvil (z-index 55): logo y botón X siempre visibles */
  }

  /* Marca / logo */
  .mark { display: flex; align-items: center; flex-shrink: 0; }
  .mark img {
    height: 66px;
    width: auto;
    display: block;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mark:hover img { transform: scale(1.04); }

  /* Navegación */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .site-nav__inner { display: contents; }
  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .site-nav a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.94rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .site-nav__links > a {
    position: relative;
    padding-bottom: 3px;
  }
  .site-nav__links > a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1.5px;
    background: var(--teal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site-nav__links > a:hover::after,
  .site-nav__links > a.active::after { transform: scaleX(1); }
  .site-nav a.active, .site-nav a:hover { color: var(--teal-dark); }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--teal);
    color: #FBFDFD !important;
    padding: 10px 20px;
    border-radius: 999px;
    font-weight: 600 !important;
    font-size: 0.9rem !important;
    white-space: nowrap;
    transition: background-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }
  .site-nav__cta:hover {
    background: var(--teal-dark);
    transform: translateY(-1px);
    box-shadow: 0 10px 20px -10px rgba(41, 38, 91, 0.5);
  }

  /* Desplegables */
  .dropdown { position: relative; }
  .dropdown summary {
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    color: var(--ink-soft);
    font-size: 0.94rem;
    font-weight: 500;
    list-style: none;
    white-space: nowrap;
  }
  .dropdown summary::-webkit-details-marker { display: none; }
  .dropdown summary.active, .dropdown summary:hover { color: var(--teal-dark); }
  .dropdown summary::after {
    content: '';
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    margin-top: -3px;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .dropdown[open] summary::after { transform: rotate(-135deg); margin-top: 3px; }

  .dropdown-panel {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    top: calc(100% + 16px);
    left: -18px;
    min-width: 250px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 20px 40px -20px rgba(41, 38, 91, 0.35);
    padding: 10px 0;
    z-index: 60;
    animation: dropdownIn 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes dropdownIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .dropdown-panel li a {
    display: block;
    padding: 10px 20px;
    font-size: 0.92rem;
    color: var(--ink);
    border-left: 2px solid transparent;
    transition: background-color 160ms ease, border-color 160ms ease, padding-left 160ms ease;
  }
  .dropdown-panel li a:hover {
    background: var(--bg-soft);
    color: var(--teal-dark);
    border-left-color: var(--teal);
    padding-left: 24px;
  }

  /* Botón hamburguesa — oculto en escritorio */
  .nav-toggle { display: none; }
  .nav-toggle-label {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    cursor: pointer;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 200ms ease;
  }
  .nav-toggle-label:hover,
  .nav-toggle-label:active { background: var(--bg-soft); }
  .nav-toggle-label span {
    width: 26px;
    height: 2.5px;
    border-radius: 2px;
    background: var(--teal-dark);
    transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1), opacity 180ms ease;
  }
  .nav-toggle:checked + .nav-toggle-label span:nth-child(1) { transform: translateY(8.5px) rotate(45deg); }
  .nav-toggle:checked + .nav-toggle-label span:nth-child(2) { opacity: 0; }
  .nav-toggle:checked + .nav-toggle-label span:nth-child(3) { transform: translateY(-8.5px) rotate(-45deg); }

  @media (max-width: 1040px) {
    .mark img { height: 54px; }

    .nav-toggle-label { display: flex; }

    /* Menú móvil: cajón de pantalla completa, no un desplegable a medias */
    .site-nav {
      position: fixed;
      inset: 0;
      z-index: 55;
      background: var(--bg);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity 260ms ease, transform 260ms ease, visibility 0s linear 260ms;
    }
    .nav-toggle:checked ~ .site-nav {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition: opacity 260ms ease, transform 260ms ease, visibility 0s linear 0s;
    }
    .site-nav__inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
      min-height: 100%;
      min-height: 100dvh;
      padding: calc(70px + env(safe-area-inset-top, 0px)) 28px calc(32px + env(safe-area-inset-bottom, 0px));
      box-sizing: border-box;
      overflow-y: auto;
      border-bottom: none;
      box-shadow: none;
    }
    .site-nav__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
    }
    .site-nav__links > a {
      padding: 17px 16px 17px 18px;
      margin: 0 -16px;
      width: calc(100% + 32px);
      border-radius: 10px;
      font-size: 1.14rem;
      font-weight: 600;
      color: var(--ink-soft);
      border-bottom: 1px solid var(--line);
      border-left: 3px solid transparent;
      transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
    }
    .site-nav__links > a::after { display: none; }
    .site-nav__links > a.active {
      color: var(--teal-dark);
      background: var(--bg-soft);
      border-left-color: var(--teal);
    }
    .site-nav__cta {
      margin-top: 22px;
      justify-content: center;
      border-radius: 999px;
      padding: 15px 20px;
      font-size: 1rem !important;
    }

    /* En móvil, el desplegable se expande en línea dentro del menú */
    .dropdown { width: 100%; border-bottom: 1px solid var(--line); }
    .dropdown summary {
      padding: 17px 16px 17px 18px;
      margin: 0 -16px;
      width: calc(100% + 32px);
      box-sizing: border-box;
      border-radius: 10px 10px 0 0;
      justify-content: space-between;
      font-size: 1.14rem;
      font-weight: 600;
      color: var(--ink-soft);
      border-left: 3px solid transparent;
      transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
    }
    .dropdown summary.active {
      color: var(--teal-dark);
      background: var(--bg-soft);
      border-left-color: var(--teal);
    }
    .dropdown[open] summary { padding-bottom: 8px; }
    .dropdown-panel {
      position: static;
      border: none;
      box-shadow: none;
      background: var(--bg-soft);
      margin: 0 0 14px;
      padding: 6px 4px;
      border-radius: 12px;
      animation: none;
    }
    .dropdown-panel li a { padding: 12px 14px; font-size: 1rem; }
    .dropdown-panel li a:hover { padding-left: 20px; }

    /* Aparición escalonada de cada enlace al abrir el menú */
    .site-nav__links > *,
    .site-nav__cta {
      opacity: 0;
      transform: translateY(14px);
    }
    .nav-toggle:checked ~ .site-nav .site-nav__links > * {
      animation: navItemIn 480ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .nav-toggle:checked ~ .site-nav .site-nav__cta {
      animation: navItemIn 480ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: 430ms;
    }
    .nav-toggle:checked ~ .site-nav .site-nav__links > *:nth-child(1) { animation-delay: 90ms; }
    .nav-toggle:checked ~ .site-nav .site-nav__links > *:nth-child(2) { animation-delay: 140ms; }
    .nav-toggle:checked ~ .site-nav .site-nav__links > *:nth-child(3) { animation-delay: 190ms; }
    .nav-toggle:checked ~ .site-nav .site-nav__links > *:nth-child(4) { animation-delay: 240ms; }
    .nav-toggle:checked ~ .site-nav .site-nav__links > *:nth-child(5) { animation-delay: 290ms; }
    .nav-toggle:checked ~ .site-nav .site-nav__links > *:nth-child(6) { animation-delay: 340ms; }
    .nav-toggle:checked ~ .site-nav .site-nav__links > *:nth-child(7) { animation-delay: 390ms; }
    @keyframes navItemIn {
      to { opacity: 1; transform: translateY(0); }
    }
  }

  @media (max-width: 1040px) and (prefers-reduced-motion: reduce) {
    .site-nav { transition: none; }
    .site-nav__links > *, .site-nav__cta { opacity: 1; transform: none; animation: none; }
  }
</style>
