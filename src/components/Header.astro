---
import { site, nav, whatsappLink } from '../data/site.js';
const { pathname } = Astro.url;
const tel = `tel:${site.phoneDisplay.replace(/\s/g, '')}`;
const firstHours = site.hours[0];
---
<!-- Barra superior: contacto rápido y redes (solo escritorio) -->
<div class="topbar">
  <div class="container topbar__inner">
    <div class="topbar__info">
      <a href={tel}><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg><span>Línea directa y WhatsApp: {site.phoneDisplay}</span></a>
      <span class="topbar__item"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>{firstHours.day}: {firstHours.time}</span></span>
    </div>
    <div class="topbar__social">
      <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.6h2.6l.4-3H13.5V8.4c0-.9.3-1.5 1.6-1.5h1.7V4.2C16.5 4.1 15.5 4 14.4 4c-2.3 0-3.9 1.4-3.9 4v2.4H8v3h2.5V21h3Z"/></svg></a>
      <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1"/></svg></a>
      <a href={site.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M16.6 5.1c.7.9 1.7 1.5 2.9 1.6v2.6c-1.2 0-2.3-.4-3.2-1v6.4c0 2.7-2.1 4.8-4.8 4.8S6.7 17.4 6.7 14.7c0-2.6 2-4.7 4.6-4.8v2.7c-1.1.1-2 1-2 2.1 0 1.2 1 2.2 2.2 2.2s2.2-1 2.2-2.2V3.5h2.7c0 .6.1 1.1.2 1.6Z"/></svg></a>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="container bar">
    <a href="/" class="mark" aria-label={`${site.doctorName} — Inicio`}>
      <img src="/images/logo.png" alt={site.doctorName} width="640" height="422" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Navegación principal">
      <div class="site-nav__inner">
      <div class="site-nav__links">
        {nav.map((item) => (
          item.groups ? (
            <details class="dropdown" name="main-nav">
              <summary
                class={pathname === item.href || pathname.startsWith(item.href + '/') || pathname.startsWith(item.href + '#') ? 'active' : ''}
              >
                {item.label}
              </summary>
              <div class="mega" style={`--cols:${item.cols ?? item.groups.length}`}>
                <div class="mega__grid">
                  {item.groups.map((g) => (
                    <div class="mega__group">
                      {g.href ? <a class="mega__title" href={g.href}>{g.title}</a> : <p class="mega__title">{g.title}</p>}
                      <ul>
                        {g.links.map((l) => (
                          <li><a href={l.href}>{l.label}</a></li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                {item.footer && <a class="mega__footer" href={item.footer.href}>{item.footer.label} →</a>}
              </div>
            </details>
          ) : (
            <a
              href={item.href}
              class={pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href)) ? 'active' : ''}
            >
              {item.label}
            </a>
          )
        ))}
      </div>

      <a class="site-nav__cta" href={whatsappLink('Hola, quisiera agendar una cita.')} target="_blank" rel="noopener">
        <svg viewBox="0 0 32 32" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d="M16 3C9.4 3 4 8.4 4 15c0 2.4.7 4.6 1.9 6.5L4 29l7.7-2c1.8 1 3.9 1.5 6.3 1.5 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-2.1 0-4.1-.6-5.8-1.6l-.4-.2-4.6 1.2 1.2-4.5-.3-.5C4.9 17.7 4.2 16.4 4.2 15 4.2 9.5 9.5 5.2 16 5.2S27.8 9.5 27.8 15 22.5 24.8 16 24.8zm6.1-8.2c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.7.2s-.8 1.1-1 1.3c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-2-1.8-2.3-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.6-.7 1.9-1.3.2-.6.2-1.1.2-1.3-.1-.1-.3-.2-.6-.3z"/>
        </svg>
        Agendar cita
      </a>

      <div class="site-nav__contact">
        <a href={tel}>{site.phoneDisplay}</a>
        <div class="site-nav__social">
          <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.6h2.6l.4-3H13.5V8.4c0-.9.3-1.5 1.6-1.5h1.7V4.2C16.5 4.1 15.5 4 14.4 4c-2.3 0-3.9 1.4-3.9 4v2.4H8v3h2.5V21h3Z"/></svg></a>
          <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1"/></svg></a>
          <a href={site.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M16.6 5.1c.7.9 1.7 1.5 2.9 1.6v2.6c-1.2 0-2.3-.4-3.2-1v6.4c0 2.7-2.1 4.8-4.8 4.8S6.7 17.4 6.7 14.7c0-2.6 2-4.7 4.6-4.8v2.7c-1.1.1-2 1-2 2.1 0 1.2 1 2.2 2.2 2.2s2.2-1 2.2-2.2V3.5h2.7c0 .6.1 1.1.2 1.6Z"/></svg></a>
        </div>
      </div>
      </div>
    </nav>
  </div>
</header>

<script>
  // Cierra los desplegables del menú al hacer clic fuera o con Escape,
  // y añade sombra al header cuando hay scroll.
  document.addEventListener('click', (event) => {
    document.querySelectorAll('.site-nav details[open]').forEach((el) => {
      if (!(el as HTMLElement).contains(event.target as Node)) {
        el.removeAttribute('open');
      }
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      document.querySelectorAll('.site-nav details[open]').forEach((el) => el.removeAttribute('open'));
    }
  });

  const header = document.querySelector('.site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menús grandes (escritorio): si el panel se sale de la pantalla, lo desplaza para que quepa.
  const placeMega = (d: HTMLDetailsElement) => {
    const p = d.querySelector<HTMLElement>('.mega');
    if (!p || window.innerWidth <= 1100) return;
    p.style.setProperty('--shift', '0px');
    const r = p.getBoundingClientRect();
    const pad = 16;
    let shift = 0;
    if (r.right > window.innerWidth - pad) shift = window.innerWidth - pad - r.right;
    if (r.left + shift < pad) shift = pad - r.left;
    p.style.setProperty('--shift', `${shift}px`);
  };
  document.querySelectorAll<HTMLDetailsElement>('.site-nav details.dropdown').forEach((d) =>
    d.addEventListener('toggle', () => { if (d.open) placeMega(d); })
  );
  window.addEventListener('resize', () =>
    document.querySelectorAll('.site-nav details[open]').forEach((el) => el.removeAttribute('open'))
  );

  // Menú móvil: bloquea el scroll del fondo mientras está abierto,
  // y lo cierra al elegir un enlace o con Escape.
  const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
  const lockScroll = (locked: boolean) => {
    document.documentElement.style.overflow = locked ? 'hidden' : '';
  };
  toggle?.addEventListener('change', () => lockScroll(toggle.checked));
  document.querySelectorAll('.site-nav__links > a').forEach((a) =>
    a.addEventListener('click', () => { if (toggle) { toggle.checked = false; lockScroll(false); } })
  );
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.checked) { toggle.checked = false; lockScroll(false); }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    /* Fondo sólido (sin backdrop-filter): el blur hacía que el menú de pantalla
       completa calculara "fixed" respecto al header en vez de respecto a toda
       la pantalla, por un comportamiento del estándar de CSS poco conocido. */
    background: rgba(251, 253, 253, 0.97);
    border-bottom: 1px solid transparent;
    transition: border-color 220ms ease, box-shadow 220ms ease;
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 8px 24px -18px rgba(41, 38, 91, 0.35);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    padding-bottom: 8px;
    position: relative;
    z-index: 56; /* por encima del menú móvil (z-index 55): logo y botón X siempre visibles */
  }

  /* Marca / logo */
  .mark { display: flex; align-items: center; flex-shrink: 0; }
  .mark img {
    height: 66px;
    width: auto;
    display: block;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mark:hover img { transform: scale(1.04); }

  /* Navegación */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .site-nav__inner { display: contents; }
  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .site-nav a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.94rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .site-nav__links > a {
    position: relative;
    padding-bottom: 3px;
  }
  .site-nav__links > a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1.5px;
    background: var(--teal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site-nav__links > a:hover::after,
  .site-nav__links > a.active::after { transform: scaleX(1); }
  .site-nav a.active, .site-nav a:hover { color: var(--teal-dark); }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--teal);
    color: #FBFDFD !important;
    padding: 10px 20px;
    border-radius: 999px;
    font-weight: 600 !important;
    font-size: 0.9rem !important;
    white-space: nowrap;
    transition: background-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }
  .site-nav__cta:hover {
    background: var(--teal-dark);
    transform: translateY(-1px);
    box-shadow: 0 10px 20px -10px rgba(41, 38, 91, 0.5);
  }

  /* Desplegables */
  .dropdown { position: relative; }
  .dropdown summary {
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    color: var(--ink-soft);
    font-size: 0.94rem;
    font-weight: 500;
    list-style: none;
    white-space: nowrap;
  }
  .dropdown summary::-webkit-details-marker { display: none; }
  .dropdown summary.active, .dropdown summary:hover { color: var(--teal-dark); }
  .dropdown summary::after {
    content: '';
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    margin-top: -3px;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .dropdown[open] summary::after { transform: rotate(-135deg); margin-top: 3px; }

  /* Panel grande dividido por secciones */
  .mega {
    position: absolute;
    top: calc(100% + 16px);
    left: calc(-24px + var(--shift, 0px));
    width: max-content;
    max-width: calc(100vw - 32px);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 24px 48px -24px rgba(41, 38, 91, 0.4);
    padding: 26px 30px 22px;
    z-index: 60;
    animation: dropdownIn 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes dropdownIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .mega__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 2), minmax(200px, 1fr));
    gap: 28px 44px;
  }
  .mega__group ul { list-style: none; margin: 0; padding: 0; }
  .site-nav .mega__title {
    display: block;
    margin: 0 0 10px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--teal-dark);
  }
  .site-nav a.mega__title:hover { color: var(--teal); }
  .site-nav .mega__group li a {
    display: block;
    padding: 7px 0 7px 12px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--ink);
    border-left: 2px solid transparent;
    transition: color 160ms ease, border-color 160ms ease, padding-left 160ms ease;
  }
  .site-nav .mega__group li a:hover {
    color: var(--teal-dark);
    border-left-color: var(--teal);
    padding-left: 16px;
  }
  .site-nav .mega__footer {
    display: block;
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--teal);
  }
  .site-nav .mega__footer:hover { color: var(--teal-dark); }

  /* Contacto dentro del menú móvil (oculto en escritorio) */
  .site-nav__contact { display: none; }

  /* Barra superior */
  .topbar { background: var(--teal-dark); color: #DCEFF1; font-size: 0.82rem; }
  .topbar__inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 38px; }
  .topbar__info { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
  .topbar a, .topbar__item { display: inline-flex; align-items: center; gap: 8px; color: #DCEFF1; text-decoration: none; }
  .topbar a:hover { color: #fff; }
  .topbar svg { flex-shrink: 0; opacity: 0.9; }
  .topbar__social { display: flex; align-items: center; gap: 4px; }
  .topbar__social a { width: 30px; height: 30px; justify-content: center; border-radius: 50%; transition: background-color 200ms ease; }
  .topbar__social a:hover { background: rgba(255, 255, 255, 0.16); }

  /* Botón hamburguesa — oculto en escritorio */
  .nav-toggle { display: none; }
  .nav-toggle-label {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    cursor: pointer;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 200ms ease;
  }
  .nav-toggle-label:hover,
  .nav-toggle-label:active { background: var(--bg-soft); }
  .nav-toggle-label span {
    width: 26px;
    height: 2.5px;
    border-radius: 2px;
    background: var(--teal-dark);
    transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1), opacity 180ms ease;
  }
  .nav-toggle:checked + .nav-toggle-label span:nth-child(1) { transform: translateY(8.5px) rotate(45deg); }
  .nav-toggle:checked + .nav-toggle-label span:nth-child(2) { opacity: 0; }
  .nav-toggle:checked + .nav-toggle-label span:nth-child(3) { transform: translateY(-8.5px) rotate(-45deg); }

  @media (max-width: 1100px) {
    .mark img { height: 54px; }

    .nav-toggle-label { display: flex; }

    /* Menú móvil: cajón de pantalla completa, no un desplegable a medias */
    .site-nav {
      position: fixed;
      inset: 0;
      z-index: 55;
      background: var(--bg);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: opacity 260ms ease, transform 260ms ease, visibility 0s linear 260ms;
    }
    .nav-toggle:checked ~ .site-nav {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition: opacity 260ms ease, transform 260ms ease, visibility 0s linear 0s;
    }
    .site-nav__inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
      min-height: 100%;
      min-height: 100dvh;
      padding: calc(70px + env(safe-area-inset-top, 0px)) 28px calc(32px + env(safe-area-inset-bottom, 0px));
      box-sizing: border-box;
      overflow-y: auto;
      border-bottom: none;
      box-shadow: none;
    }
    .site-nav__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
    }
    .site-nav__links > a {
      padding: 17px 16px 17px 18px;
      margin: 0 -16px;
      width: calc(100% + 32px);
      border-radius: 10px;
      font-size: 1.14rem;
      font-weight: 600;
      color: var(--ink-soft);
      border-bottom: 1px solid var(--line);
      border-left: 3px solid transparent;
      transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
    }
    .site-nav__links > a::after { display: none; }
    .site-nav__links > a.active {
      color: var(--teal-dark);
      background: var(--bg-soft);
      border-left-color: var(--teal);
    }
    .site-nav__cta {
      margin-top: 22px;
      justify-content: center;
      border-radius: 999px;
      padding: 15px 20px;
      font-size: 1rem !important;
    }

    /* En móvil, el desplegable se expande en línea dentro del menú */
    .dropdown { width: 100%; border-bottom: 1px solid var(--line); }
    .dropdown summary {
      padding: 17px 16px 17px 18px;
      margin: 0 -16px;
      width: calc(100% + 32px);
      box-sizing: border-box;
      border-radius: 10px 10px 0 0;
      justify-content: space-between;
      font-size: 1.14rem;
      font-weight: 600;
      color: var(--ink-soft);
      border-left: 3px solid transparent;
      transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
    }
    .dropdown summary.active {
      color: var(--teal-dark);
      background: var(--bg-soft);
      border-left-color: var(--teal);
    }
    .dropdown[open] summary { padding-bottom: 8px; }
    .mega {
      position: static;
      width: auto;
      max-width: none;
      border: none;
      box-shadow: none;
      background: var(--bg-soft);
      margin: 0 0 14px;
      padding: 14px 16px 6px;
      border-radius: 12px;
      animation: none;
    }
    .mega__grid { grid-template-columns: 1fr; gap: 14px; }
    .site-nav .mega__title { margin-bottom: 2px; padding-bottom: 6px; border-bottom: none; font-size: 0.72rem; }
    .site-nav .mega__group li a { padding: 11px 0 11px 12px; font-size: 1rem; }
    .site-nav .mega__group li a:hover { padding-left: 16px; }
    .site-nav .mega__footer { margin-top: 6px; padding: 12px 0 10px; font-size: 0.95rem; }

    .topbar { display: none; }

    .site-nav__contact {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-top: 26px;
      padding-top: 20px;
      border-top: 1px solid var(--line);
    }
    .site-nav__contact > a { font-size: 1rem; font-weight: 600; color: var(--teal-dark); }
    .site-nav__social { display: flex; gap: 8px; }
    .site-nav__social a {
      width: 42px; height: 42px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      border: 1px solid var(--line); color: var(--teal-dark);
    }

    /* Aparición escalonada de cada enlace al abrir el menú */
    .site-nav__links > *,
    .site-nav__cta,
    .site-nav__contact {
      opacity: 0;
      transform: translateY(14px);
    }
    .nav-toggle:checked ~ .site-nav .site-nav__links > * {
      animation: navItemIn 480ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .nav-toggle:checked ~ .site-nav .site-nav__cta {
      animation: navItemIn 480ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: 430ms;
    }
    .nav-toggle:checked ~ .site-nav .site-nav__contact {
      animation: navItemIn 480ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: 520ms;
    }
    .nav-toggle:checked ~ .site-nav .site-nav__links > *:nth-child(1) { animation-delay: 90ms; }
    .nav-toggle:checked ~ .site-nav .site-nav__links > *:nth-child(2) { animation-delay: 140ms; }
