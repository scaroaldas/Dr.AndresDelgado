---
// Invitación a calificar en Google. Las reseñas en Google son lo que más ayuda al posicionamiento local.
import { site, googleReviewLink, googleReadLink } from '../data/site.js';
const { compact = false } = Astro.props as { compact?: boolean };
---
<div class:list={['review-cta', { 'review-cta--compact': compact }]} data-reveal>
  <div class="review-cta__stars" aria-hidden="true">★★★★★</div>
  <h3>¿Te atendimos? Cuéntanos tu experiencia</h3>
  <p>Tu opinión en Google ayuda a otras familias a encontrarnos y a decidir con confianza. Toma menos de un minuto.</p>
  <div class="review-cta__actions">
    <a class="btn btn--primary" href={googleReviewLink()} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.3-.2-1.9H12v3.6h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.2Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.4 13.9a6 6 0 0 1 0-3.8V7.5H3.1a10 10 0 0 0 0 9l3.3-2.6Z"/><path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 0 0 3.1 7.5l3.3 2.6C7.2 7.8 9.4 6 12 6Z"/></svg>
      Calificar en Google
    </a>
    <a class="btn btn--ghost" href={googleReadLink()} target="_blank" rel="noopener">Ver reseñas</a>
  </div>
</div>

<style>
  .review-cta { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 38px 34px; text-align: center; max-width: 720px; margin: 0 auto; box-shadow: 0 24px 44px -34px rgba(41, 38, 91, 0.35); }
  .review-cta__stars { font-size: 1.9rem; letter-spacing: 6px; color: #E4B94C; line-height: 1; margin-bottom: 14px; }
  .review-cta h3 { font-size: 1.5rem; margin-bottom: 0.3em; }
  .review-cta p { margin: 0 auto 22px; color: var(--ink-soft); }
  .review-cta__actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .review-cta__actions .btn svg { flex-shrink: 0; background: #fff; border-radius: 50%; padding: 2px; }
  .review-cta--compact { padding: 28px 24px; }
  @media (max-width: 520px) { .review-cta { padding: 28px 20px; } .review-cta__actions .btn { width: 100%; justify-content: center; } }
</style>
