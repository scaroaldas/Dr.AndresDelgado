---
// Fotos reales del consultorio (en /public/images/team/consultorio-*.jpg).
const fotos = [
  { src: '/images/team/consultorio-escritorio.jpg', alt: 'Consultorio del Dr. Andrés Delgado: escritorio y sillas de atención', cap: 'Consultorio' },
  { src: '/images/team/consultorio-recepcion.jpg', alt: 'Recepción y sala de espera con el logotipo del Dr. Andrés Delgado', cap: 'Recepción y sala de espera' },
  { src: '/images/team/consultorio-sala-procedimientos.jpg', alt: 'Sala de procedimientos con sillón de exploración y equipo de ecografía y endoscopia', cap: 'Sala de procedimientos' },
  { src: '/images/team/consultorio-logo.jpg', alt: 'Pared con el logotipo del consultorio e iluminación cálida', cap: 'Nuestro espacio' },
];
---
<div class="cons-gal" data-reveal-group>
  {fotos.map((f, i) => (
    <figure class={`cons-gal__item cons-gal__item--${i}`}>
      <img src={f.src} alt={f.alt} width="1800" height="1202" loading="lazy" />
      <figcaption>{f.cap}</figcaption>
    </figure>
  ))}
</div>

<style>
  .cons-gal { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px; margin-top: 8px; }
  .cons-gal__item { margin: 0; position: relative; overflow: hidden; border-radius: 12px; border: 1px solid var(--line); background: var(--bg-soft); aspect-ratio: 4 / 3; }
  .cons-gal__item--0 { grid-column: span 4; aspect-ratio: 16 / 10; }
  .cons-gal__item--1 { grid-column: span 2; aspect-ratio: auto; }
  .cons-gal__item--2, .cons-gal__item--3 { grid-column: span 3; }
  .cons-gal__item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1); }
  .cons-gal__item:hover img { transform: scale(1.04); }
  .cons-gal__item figcaption { position: absolute; left: 12px; bottom: 12px; padding: 5px 12px; border-radius: 999px; font-size: 0.82rem; font-weight: 600; color: var(--teal-dark); background: rgba(255, 255, 255, 0.88); }
  @media (max-width: 760px) {
    .cons-gal { grid-template-columns: 1fr 1fr; }
    .cons-gal__item--0 { grid-column: span 2; }
    .cons-gal__item--1, .cons-gal__item--2, .cons-gal__item--3 { grid-column: span 1; aspect-ratio: 4 / 5; }
    .cons-gal__item--3 { grid-column: span 2; aspect-ratio: 4 / 3; }
  }
</style>
