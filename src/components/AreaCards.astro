---
<section class="section areas">
  <div class="container">
    <span class="eyebrow">Áreas de atención</span>
    <h2>Un consultorio, todas las etapas de tu salud reproductiva</h2>

    <div class="areas__grid" data-reveal-group>
      {areas.map((a) => (
        <a class="areas__card" href={a.href}>
          <span class="areas__icon" aria-hidden="true">
            <Fragment set:html={icons[a.icon]} />
          </span>
          <h3>{a.title}</h3>
          <p>{a.text}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .areas__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: 32px;
  }
  .areas__card {
    background: var(--bg-soft);
    padding: 30px 28px;
    text-decoration: none;
    color: var(--ink);
    position: relative;
    transition: background-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
  }
  .areas__card:hover, .areas__card:focus-visible {
    background: var(--white);
    transform: translateY(-4px);
    box-shadow: 0 16px 28px -18px rgba(41, 38, 91, 0.3);
    z-index: 1;
  }
  .areas__icon {
    width: 96px; height: 96px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: radial-gradient(circle at 35% 28%, #FFFFFF 0%, #EAF6F7 100%);
    border: 1px solid var(--line);
    margin-bottom: 18px;
    transition: border-color 260ms ease, box-shadow 260ms ease, transform 260ms ease;
  }
  .areas__icon :global(svg) { width: 76px; height: 76px; display: block; transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1); }
  .areas__card:hover .areas__icon, .areas__card:focus-visible .areas__icon {
    border-color: var(--teal);
    box-shadow: 0 14px 26px -14px rgba(91, 190, 197, 0.9);
  }
  .areas__card:hover .areas__icon :global(svg), .areas__card:focus-visible .areas__icon :global(svg) { transform: scale(1.08) translateY(-2px); }
  .areas__card h3 { margin: 0 0 0.4em; color: var(--teal-dark); }
  .areas__card p { margin: 0; color: var(--ink-soft); font-size: 0.94rem; }

  @media (max-width: 900px) { .areas__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .areas__grid { grid-template-columns: 1fr; } }
</style>
