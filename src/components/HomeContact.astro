---
import { site, whatsappLink } from '../data/site.js';
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.address.mapsQuery)}&output=embed`;
---
<section class="section section--soft home-contact" id="agenda">
  <div class="container">
    <div class="home-contact__grid">
      <div data-reveal>
        <span class="eyebrow">Contacto</span>
        <h2>Agenda tu cita</h2>
        <p class="lede">Escríbenos y coordinamos el horario que mejor te convenga.{site.hoursNote ? ` ${site.hoursNote}` : ''}</p>
        <ul class="hc-list">
          <li><span>WhatsApp y teléfono</span><a href={whatsappLink()} target="_blank" rel="noopener">{site.phoneDisplay}</a></li>
          <li><span>Correo</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><span>Dirección</span><a href={site.address.mapsUrl} target="_blank" rel="noopener">{site.address.line1}, {site.address.city}</a></li>
          <li><span>Horario</span><span>{site.hours.map((h) => `${h.day}: ${h.time}`).join(' · ')}</span></li>
        </ul>
      </div>

      <form class="hc-form" id="hc-form" data-wa={site.whatsappNumber} data-reveal>
        <h3>Déjanos tus datos</h3>
        <label>Nombre completo
          <input name="nombre" required autocomplete="name" />
        </label>
        <label>Teléfono o WhatsApp
          <input name="telefono" type="tel" autocomplete="tel" />
        </label>
        <label>Motivo de la consulta
          <select name="motivo">
            <option>Primera consulta de fertilidad</option>
            <option>Control de embarazo</option>
            <option>Control ginecológico</option>
            <option>Cirugía o procedimiento</option>
            <option>Otro motivo</option>
          </select>
        </label>
        <label>Mensaje (opcional)
          <textarea name="mensaje" rows="3"></textarea>
        </label>
        <button type="submit" class="btn btn--whatsapp">Enviar por WhatsApp</button>
        <p class="hc-note">Se abrirá WhatsApp con tu mensaje listo para enviar.</p>
      </form>
    </div>

    <div class="hc-map" data-reveal>
      <iframe title="Ubicación del consultorio" src={mapSrc} width="100%" height="340" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('hc-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const nombre = String(d.get('nombre') || '').trim();
    const tel = String(d.get('telefono') || '').trim();
    const motivo = String(d.get('motivo') || '').trim();
    const msg = String(d.get('mensaje') || '').trim();
    let text = `Hola, soy ${nombre}. Quisiera agendar una cita (${motivo}).`;
    if (msg) text += ` ${msg}`;
    if (tel) text += ` Mi teléfono: ${tel}.`;
    window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
  });
</script>

<style>
  .home-contact__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .hc-list { list-style: none; padding: 0; margin: 22px 0 0; }
  .hc-list li { display: flex; flex-direction: column; gap: 2px; padding: 14px 0; border-top: 1px solid var(--line); font-size: 0.95rem; }
  .hc-list li:last-child { border-bottom: 1px solid var(--line); }
  .hc-list li > span:first-child { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); }
  .hc-list a { color: var(--teal-dark); }

  .hc-form { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 30px; display: flex; flex-direction: column; gap: 16px; }
  .hc-form h3 { margin: 0 0 4px; }
  .hc-form label { display: flex; flex-direction: column; gap: 6px; font-size: 0.88rem; font-weight: 600; color: var(--ink); }
  .hc-form input, .hc-form select, .hc-form textarea {
    font: inherit; font-weight: 400; font-size: 0.97rem; color: var(--ink);
    padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--radius); background: #fff;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .hc-form input:focus, .hc-form select:focus, .hc-form textarea:focus {
    outline: none; border-color: var(--teal); box-shadow: 0 0 0 3px rgba(91, 190, 197, 0.25);
  }
  .hc-form .btn { justify-content: center; border: none; cursor: pointer; font-family: inherit; }
  .hc-note { margin: 0; font-size: 0.82rem; color: var(--ink-soft); }

  .hc-map { margin-top: 40px; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; line-height: 0; }
  .hc-map iframe { display: block; }
  @media (max-width: 900px) { .home-contact__grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
