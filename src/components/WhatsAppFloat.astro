---
import { whatsappLink } from '../data/site.js';
---
<a
  href={whatsappLink()}
  target="_blank"
  rel="noopener"
  class="wa-float"
  aria-label="Escribir por WhatsApp para agendar una cita"
>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" fill="currentColor">
    <path d="M16 3C9.4 3 4 8.4 4 15c0 2.4.7 4.6 1.9 6.5L4 29l7.7-2c1.8 1 3.9 1.5 6.3 1.5 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-2.1 0-4.1-.6-5.8-1.6l-.4-.2-4.6 1.2 1.2-4.5-.3-.5C4.9 17.7 4.2 16.4 4.2 15 4.2 9.5 9.5 5.2 16 5.2S27.8 9.5 27.8 15 22.5 24.8 16 24.8zm6.1-8.2c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.7.2s-.8 1.1-1 1.3c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-2-1.8-2.3-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3 4.8 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.6-.7 1.9-1.3.2-.6.2-1.1.2-1.3-.1-.1-.3-.2-.6-.3z"/>
  </svg>
  <span class="wa-float__label">Escríbenos</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #25913C;
    color: #fff;
    text-decoration: none;
    padding: 13px 18px;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.18);
  }
  .wa-float__label { font-family: var(--font-body); font-weight: 600; font-size: 0.92rem; }

  @media (max-width: 560px) {
    .wa-float__label { display: none; }
    .wa-float { padding: 13px; }
  }
</style>
