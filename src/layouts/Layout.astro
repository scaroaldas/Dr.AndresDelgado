---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import '../styles/global.css';
import { site } from '../data/site.js';
import { tratamientos } from '../data/tratamientos.js';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Datos estructurados extra de la página (sin "@context"). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Consulta de fertilidad, obstetricia y ginecología en Cuenca, Ecuador.',
  image = '/images/og.jpg',
  noindex = false,
  jsonLd,
} = Astro.props as Props;

const origin = (Astro.site ?? Astro.url).origin;
const abs = (p: string) => new URL(p, origin).href;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = abs(path);

// ---- Datos estructurados para Google (médico, consultorio, horario, redes) ----
const clinicId = abs('/#consultorio');
const personId = abs('/#doctor');
const redes = [site.social.facebook, site.social.instagram, site.social.tiktok, site.googleBusinessUrl].filter(Boolean);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Physician',
      '@id': clinicId,
      name: site.doctorName,
      description: 'Consulta de fertilidad, obstetricia y ginecología en Cuenca, Ecuador.',
      url: abs('/'),
      image: abs('/images/team/hero-sign.jpg'),
      logo: abs('/images/logo.png'),
      telephone: `+${site.whatsappNumber}`,
      email: site.email,
      medicalSpecialty: ['Gynecologic', 'Obstetric'],
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.line1,
        addressLocality: 'Cuenca',
        addressRegion: 'Azuay',
        addressCountry: 'EC',
      },
      areaServed: { '@type': 'City', name: 'Cuenca' },
      hasMap: site.googleBusinessUrl || site.address.mapsUrl,
      openingHoursSpecification: site.hoursSchema.map((h) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: h.days,
        opens: h.opens,
        closes: h.closes,
      })),
      sameAs: redes,
      availableService: tratamientos.map((t) => ({ '@type': 'MedicalProcedure', name: t.nombre, url: abs(`/tratamientos/${t.slug}`) })),
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Andrés Delgado Ponce',
      honorificPrefix: 'Dr.',
      jobTitle: 'Ginecólogo Especialista en Medicina Reproductiva e Infertilidad',
      worksFor: { '@id': clinicId },
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'Universidad de Cuenca' },
        { '@type': 'CollegeOrUniversity', name: 'Universidad Nacional Autónoma de México' },
      ],
      memberOf: [
        { '@type': 'Organization', name: 'ESHRE — Sociedad Europea de Medicina de la Reproducción' },
        { '@type': 'Organization', name: 'ASRM — Sociedad Americana de Medicina de la Reproducción' },
        { '@type': 'Organization', name: 'AMMR — Asociación Mexicana de Medicina de la Reproducción' },
      ],
      image: abs('/images/team/hero-sign.jpg'),
      sameAs: redes,
    },
    {
      '@type': 'WebSite',
      '@id': abs('/#sitio'),
      url: abs('/'),
      name: site.doctorName,
      inLanguage: 'es-EC',
      publisher: { '@id': clinicId },
    },
    ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="theme-color" content="#29265B" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={site.doctorName} />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <script>
      // Anima elementos marcados con data-reveal / data-reveal-group cuando
      // entran en el viewport, y hace un conteo ascendente en data-count-to.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              const counters = entry.target.hasAttribute('data-count-to')
                ? [entry.target]
                : Array.from(entry.target.querySelectorAll('[data-count-to]'));
              counters.forEach((node) => {
                const el = node as HTMLElement;
                if (el.dataset.counted) return;
                el.dataset.counted = 'true';
                const target = parseFloat(el.getAttribute('data-count-to') || '0');
                const suffix = el.getAttribute('data-count-suffix') || '';
                const duration = 1100;
                const start = performance.now();
                const step = (now: number) => {
                  const progress = Math.min((now - start) / duration, 1);
                  const eased = 1 - Math.pow(1 - progress, 3);
                  el.textContent = Math.round(target * eased) + suffix;
                  if (progress < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
              });
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2, rootMargin: '0px 0px -60px 0px' }
      );

      document.querySelectorAll('[data-reveal], [data-reveal-group]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
