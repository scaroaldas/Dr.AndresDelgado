---
import Layout from '../layouts/Layout.astro';
import RealPhoto from '../components/RealPhoto.astro';
import ConsultorioGallery from '../components/ConsultorioGallery.astro';
import { site } from '../data/site.js';
---
<Layout title={`Nosotros — ${site.doctorName}`} description="Quiénes somos, nuestras instalaciones, horario de atención y tasas de embarazo.">

  <section class="section page-hero">
    <div class="container">
      <span class="eyebrow">Nosotros</span>
      <h1>Un equipo dedicado a tu salud reproductiva</h1>
      <p class="lede">
        Conoce quiénes somos, cómo son nuestras instalaciones y qué puedes esperar
        de tu proceso con nosotros.
      </p>
    </div>
  </section>

  <section class="section" id="quienes-somos">
    <div class="container grid-2">
      <div data-reveal>
        <h2>Quiénes somos</h2>
        <p>
          Desde 2019 nuestra meta fue ayudar a todas aquellas parejas que tienen
          dificultades para concebir; de momento son más de 900 embarazos conseguidos
          con las diversas técnicas de reproducción asistida. Esto demuestra el
          compromiso que tenemos con toda la sociedad, manteniéndonos siempre a la
          vanguardia con constante actualización y tecnología de punta.
        </p>
        <p>
          En el área de cirugía de mínima invasión nos enfocamos en resolver cualquier
          patología del tracto genital con mínimas incisiones o ninguna, lo cual permite
          que nuestras pacientes tengan una recuperación mucho más rápida y sin cicatriz.
        </p>
        <p>
          En obstetricia buscamos acompañarte de manera cercana y cálida, comprendiendo
          que ningún miedo o pregunta es irracional.
        </p>
      </div>
      <RealPhoto src="/images/team/office-desk.jpg" alt="Dr. Andrés Delgado en su consultorio" aspect="wide" />
    </div>
  </section>

  <section class="section section--soft" id="instalaciones">
    <div class="container facility-grid">
      <RealPhoto src="/images/team/consultorio-escritorio-2.jpg" alt="Consultorio y recepción del Dr. Andrés Delgado" aspect="wide" caption="Consultorio y recepción" />
      <div data-reveal>
        <h2>Instalaciones</h2>
        <p>
          Contamos con consultorios de ginecología y obstetricia, sala de
          ecografía, quirófano equipado para cirugía laparoscópica e
          histeroscópica, laboratorio de reproducción asistida con criopreservación
          de óvulos y embriones, y una sala de espera pensada para brindar
          privacidad y tranquilidad a nuestras pacientes.
        </p>
      </div>
    </div>
    <div class="container" style="margin-top: 40px;">
      <ConsultorioGallery />
    </div>
  </section>

  <section class="section" id="horario">
    <div class="container grid-2">
      <div class="panel" data-reveal>
        <h3>Horario de atención</h3>
        <ul class="hours-list">
          {site.hours.map((h) => (
            <li><span>{h.day}</span><span>{h.time}</span></li>
          ))}
        </ul>
        {site.hoursNote && <p class="hours-note">{site.hoursNote}</p>}
      </div>
      <div class="panel" data-reveal>
        <h3>Ubicación</h3>
        <p>{site.address.line1}<br />{site.address.city}</p>
        <a href={site.address.mapsUrl} target="_blank" rel="noopener">Ver en el mapa →</a>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="tasas-embarazo">
    <div class="container">
      <span class="eyebrow">Resultados</span>
      <h2>Tasas de embarazo</h2>
      <p class="lede">
        Estas son nuestras tasas de embarazo. Los resultados varían según la edad de
        los pacientes, la reserva y calidad ovárica, la calidad del semen y la calidad
        final de los embriones.
      </p>
      <div class="stats-grid" data-reveal-group>
        <div class="stat"><strong><span data-count-to="28" data-count-suffix="%">0%</span></strong><span class="stat__label">Inseminación artificial</span></div>
        <div class="stat"><strong><span data-count-to="71" data-count-suffix="%">0%</span></strong><span class="stat__label">FIV / ICSI</span></div>
        <div class="stat"><strong><span data-count-to="84" data-count-suffix="%">0%</span></strong><span class="stat__label">Ovodonación</span></div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero { padding-top: 52px; padding-bottom: 40px; border-bottom: 1px solid var(--line); }
  .facility-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hours-list { list-style: none; padding: 0; margin: 0; }
  .hours-list li { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; font-size: 0.95rem; }
  .hours-list li span:first-child { color: var(--ink-soft); }
  .hours-note { margin: 0.9em 0 0; font-size: 0.85rem; font-style: italic; color: var(--ink-soft); }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: 32px;
  }
  .stat { background: var(--white); padding: 32px; text-align: center; }
  .stat strong {
    display: block;
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--rose-dark);
    margin-bottom: 0.2em;
  }
  .stat__label { color: var(--ink-soft); font-size: 0.92rem; }

  @media (max-width: 780px) {
    .stats-grid { grid-template-columns: 1fr; }
    .facility-grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
