---
import Layout from '../layouts/Layout.astro';
import RealPhoto from '../components/RealPhoto.astro';
import { site, whatsappLink } from '../data/site.js';
---
<Layout title={`${site.doctorName} — ${site.specialty}`}>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy" data-reveal>
        <span class="eyebrow">Consulta de fertilidad, obstetricia y ginecología</span>
        <h1>Acompañamos cada etapa del camino hacia tu familia.</h1>
        <p class="lede">
          {site.doctorName} atiende en Cuenca con un enfoque médico riguroso y un trato
          cercano, desde la primera consulta hasta el seguimiento de tu embarazo.
        </p>
        <div class="hero-actions">
          <a class="btn btn--whatsapp" href={whatsappLink('Hola, quisiera agendar una cita.')} target="_blank" rel="noopener">
            Agendar cita por WhatsApp
          </a>
          <a class="btn btn--ghost" href="/servicios">Ver servicios</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-ring spin-slow" aria-hidden="true"></div>
        <div class="hero-ring hero-ring--inner spin-slow-reverse" aria-hidden="true"></div>

        <div class="hero-carousel" id="hero-carousel">
          <img class="hero-carousel__img is-active" src="/images/team/hero-sign.jpg" alt={`${site.doctorName}, ${site.specialty}`} style="object-position:50% 16%" />
          <img class="hero-carousel__img" src="/images/team/portrait-studio.jpg" alt={site.doctorName} style="object-position:50% 12%" />
          <img class="hero-carousel__img" src="/images/team/patient-ultrasound.jpg" alt="Consulta con paciente" style="object-position:50% 28%" />
          <img class="hero-carousel__img" src="/images/team/surgery-instrument.jpg" alt="Cirugía de mínima invasión" style="object-position:50% 8%" />
        </div>

        <div class="hero-dots" aria-hidden="true">
          <span class="is-active"></span><span></span><span></span><span></span>
        </div>

        <div class="hero-badge" data-reveal>
          <strong><span data-count-to="12" data-count-suffix="+">0+</span></strong>
          <span>años de experiencia</span>
        </div>
      </div>
    </div>
  </section>

  <script>
    const imgs = document.querySelectorAll('#hero-carousel .hero-carousel__img');
    const dots = document.querySelectorAll('.hero-dots span');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (imgs.length > 1 && !prefersReduced) {
      let i = 0;
      setInterval(() => {
        imgs[i].classList.remove('is-active');
        dots[i]?.classList.remove('is-active');
        i = (i + 1) % imgs.length;
        imgs[i].classList.add('is-active');
        dots[i]?.classList.add('is-active');
      }, 4200);
    }
  </script>

  <!-- QUIEN SOY -->
  <section class="section">
    <div class="container grid-2">
      <div data-reveal>
        <span class="eyebrow">Quién soy</span>
        <h2>{site.doctorName}</h2>
        <p class="lede">{site.specialty}.</p>
        <p>
          Médico graduado de la Universidad de Cuenca, con especialización en
          Ginecología y Obstetricia y una subespecialidad en Medicina Reproductiva
          cursada en Bogotá, Colombia. Cuenta con más de 12 años de práctica clínica
          y quirúrgica, y forma parte de la Sociedad Ecuatoriana de Medicina
          Reproductiva.
        </p>
        <a class="btn btn--ghost" href="/nosotros">Conocer más sobre nosotros</a>
      </div>
      <div class="panel" data-reveal>
        <h3>Horario de atención</h3>
        <ul class="hours-list">
          {site.hours.map((h) => (
            <li><span>{h.day}</span><span>{h.time}</span></li>
          ))}
        </ul>
        <hr class="divider" />
        <h3>Ubicación</h3>
        <p>{site.address.line1}<br />{site.address.city}</p>
        <a href={site.address.mapsUrl} target="_blank" rel="noopener">Ver en el mapa →</a>
      </div>
    </div>
  </section>

  <!-- INSTALACIONES (foto) -->
  <section class="section section--soft">
    <div class="container facility-grid">
      <RealPhoto src="/images/team/clinic-entrance.jpg" alt="Entrada del consultorio" aspect="wide" caption="Nuestras instalaciones en Cuenca" />
      <div data-reveal>
        <span class="eyebrow">Instalaciones</span>
        <h2>Un espacio pensado para tu tranquilidad</h2>
        <p class="lede">
          Consultorios, quirófano propio y laboratorio de reproducción asistida,
          diseñados para que cada visita sea cómoda y privada.
        </p>
        <a class="btn btn--ghost" href="/nosotros#instalaciones">Ver instalaciones →</a>
      </div>
    </div>
  </section>

  <!-- AREAS DE SERVICIO -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Áreas de atención</span>
      <h2>Un consultorio, todas las etapas de tu salud reproductiva</h2>
      <div class="areas-grid" data-reveal-group>
        <a class="area-card" href="/servicios/fertilidad">
          <h3>Fertilidad</h3>
          <p>Inseminación artificial, fecundación in vitro, ICSI, vitrificación de óvulos y más.</p>
        </a>
        <a class="area-card" href="/servicios/donantes">
          <h3>Donantes y bancos</h3>
          <p>Óvulos, esperma y embriones, con procesos de donación seguros y acompañados.</p>
        </a>
        <a class="area-card" href="/servicios/obstetricia">
          <h3>Obstetricia</h3>
          <p>Seguimiento de embarazo normal y de alto riesgo, parto humanizado y cesárea.</p>
        </a>
        <a class="area-card" href="/servicios/cirugia">
          <h3>Cirugía de mínima invasión</h3>
          <p>Laparoscopia, histeroscopia y cirugía robótica para distintas condiciones ginecológicas.</p>
        </a>
        <a class="area-card" href="/servicios/ginecologia">
          <h3>Ginecología</h3>
          <p>Papanicolaou, colposcopia, control ginecológico y planificación familiar.</p>
        </a>
        <a class="area-card" href="/pacientes">
          <h3>Para pacientes</h3>
          <p>Qué esperar en tu primera consulta y qué pruebas diagnósticas podrías necesitar.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--teal cta">
    <div class="container cta-inner">
      <div>
        <h2>¿Tienes dudas sobre tu tratamiento?</h2>
        <p>Escríbenos por WhatsApp y coordinamos tu cita en el horario que te convenga.</p>
      </div>
      <a class="btn btn--whatsapp" href={whatsappLink()} target="_blank" rel="noopener">
        Escribir por WhatsApp
      </a>
    </div>
  </section>

</Layout>

<style>
  .hero { padding: 76px 0 84px; overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 40px;
  }
  .hero-actions { display: flex; gap: 14px; margin-top: 8px; flex-wrap: wrap; }

  .hero-visual { position: relative; height: 440px; display: flex; align-items: center; justify-content: center; }

  .hero-ring {
    position: absolute;
    border-radius: 50%;
    border: 1.5px solid var(--teal-light);
    opacity: 0.6;
    width: 380px;
    height: 380px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .hero-ring--inner {
    width: 310px;
    height: 310px;
    border-color: var(--gold);
    opacity: 0.45;
  }

  .hero-carousel {
    position: relative;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 24px 55px -20px rgba(41, 38, 91, 0.4);
    border: 5px solid var(--bg);
  }
  .hero-carousel__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    z-index: 1;
    transform: scale(1.1);
    transition: opacity 1100ms ease;
  }
  .hero-carousel__img.is-active {
    opacity: 1;
    z-index: 2;
    animation: heroKenburns 6s ease-out forwards;
  }
  @keyframes heroKenburns {
    from { transform: scale(1.1); }
    to { transform: scale(1); }
  }

  .hero-dots {
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 7px;
    z-index: 3;
  }
  .hero-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line);
    transition: background-color 300ms ease, transform 300ms ease;
  }
  .hero-dots span.is-active {
    background: var(--teal);
    transform: scale(1.3);
  }

  .hero-badge {
    position: absolute;
    left: -18px;
    bottom: 34px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 20px;
    box-shadow: 0 16px 34px -16px rgba(41, 38, 91, 0.3);
  }
  .hero-badge strong {
    font-family: var(--font-display);
    font-size: 1.7rem;
    color: var(--teal-dark);
    line-height: 1;
  }
  .hero-badge span:last-child {
    font-size: 0.78rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .facility-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .hours-list { list-style: none; padding: 0; margin: 0 0 1em; }
  .hours-list li { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; font-size: 0.95rem; }
  .hours-list li span:first-child { color: var(--ink-soft); }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: 32px;
  }
  .area-card {
    background: var(--bg-soft);
    padding: 28px;
    text-decoration: none;
    color: var(--ink);
    transition: background-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
    position: relative;
  }
  .area-card:hover {
    background: var(--white);
    transform: translateY(-4px);
    box-shadow: 0 16px 28px -18px rgba(28, 51, 47, 0.28);
    z-index: 1;
  }
  .area-card h3 { margin-bottom: 0.4em; color: var(--teal-dark); }
  .area-card p { color: var(--ink-soft); font-size: 0.94rem; margin: 0; }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .cta-inner h2 { margin-bottom: 0.3em; }
  .cta-inner p { margin: 0; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { height: 320px; margin-top: 12px; }
    .hero-ring { width: 280px; height: 280px; }
    .hero-ring--inner { width: 225px; height: 225px; }
    .hero-carousel { width: 190px; height: 190px; }
    .hero-badge { left: 6px; bottom: 4px; padding: 10px 16px; }
    .hero-badge strong { font-size: 1.3rem; }
    .areas-grid { grid-template-columns: 1fr; }
    .facility-grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
