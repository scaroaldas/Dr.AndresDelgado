---
import Layout from '../layouts/Layout.astro';
import RealPhoto from '../components/RealPhoto.astro';
import AreaCards from '../components/AreaCards.astro';
import HomeStats from '../components/HomeStats.astro';
import HomeProcess from '../components/HomeProcess.astro';
import LabGallery from '../components/LabGallery.astro';
import HomeTeam from '../components/HomeTeam.astro';
import HomeFaq from '../components/HomeFaq.astro';
import HomeContact from '../components/HomeContact.astro';
import fs from 'node:fs';
import path from 'node:path';
import { site, whatsappLink } from '../data/site.js';

// Fondos del hero: fotos de FAMILIA.
// 1) Si existen archivos hero-1.jpg, hero-2.jpg ... en /public/images/hero/, se usan esos (en orden).
// 2) Si no, se usan estas fotos gratuitas de Unsplash (licencia libre para uso comercial, sin atribución).
const unsplash = (id: string) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=1920&q=75`;
const remoteSlides = [
  { src: unsplash('1742522211724-3425d697bbf0'), mpos: '55% center' }, // familia esperando un bebé (J. Kalenberg)
  { src: unsplash('1681311311149-7254102442de'), mpos: '55% center' }, // pareja con bebé en un campo (R. Spike)
  { src: unsplash('1685580388390-576100ae9ce3'), mpos: '55% center' }, // pareja sosteniendo a su bebé (P. White)
  { src: unsplash('1681311311317-a0561a8eef74'), mpos: '55% center' }, // familia sobre una manta (R. Spike)
  { src: unsplash('1624272864537-8ecc72b67958'), mpos: '55% center' }, // papá abrazando a su hija (M. Campbell)
];
const heroDir = path.join(process.cwd(), 'public/images/hero');
const heroFiles = fs.existsSync(heroDir)
  ? fs.readdirSync(heroDir)
      .filter((f) => /^hero-\d+\.(jpe?g|webp|png)$/i.test(f))
      .sort((a, b) => parseInt(a.match(/\d+/)![0]) - parseInt(b.match(/\d+/)![0]))
  : [];
const heroSlides = heroFiles.length
  ? heroFiles.map((f) => ({ src: `/images/hero/${f}`, mpos: '55% center' }))
  : remoteSlides;
const hasPhotos = heroSlides.length > 0;
---
<Layout
  title={`${site.doctorName} — ${site.specialty}`}
  description="Consulta de fertilidad, obstetricia y ginecología en Cuenca, Ecuador. Dr. Andrés Delgado Ponce."
>

  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="hero-bg" aria-hidden="true">
      {hasPhotos ? heroSlides.map((sl, i) => (
        <div class={`hero-slide${i === 0 ? ' is-active' : ''}`} style={`background-image:url('${sl.src}'); --mpos:${sl.mpos}`}></div>
      )) : <div class="hero-slide hero-slide--fallback is-active"></div>}
      <div class="hero-overlay"></div>
    </div>

    <div class="container hero-content">
      <div class="hero-copy">
        <span class="eyebrow">Consulta de fertilidad, obstetricia y ginecología</span>
        <h1>Luchemos juntos por ese primer latido</h1>
        <p class="lede">
          {site.doctorName} atiende en Cuenca con un enfoque médico riguroso y un trato
          cercano, desde la primera consulta hasta el seguimiento de tu embarazo.
        </p>
        <div class="hero-actions">
          <a class="btn btn--whatsapp" href={whatsappLink('Hola, quisiera agendar una cita.')} target="_blank" rel="noopener">
            Agendar cita por WhatsApp
          </a>
          <a class="btn btn--ghost-inverse" href="/servicios">Ver servicios</a>
        </div>
      </div>
    </div>

    {heroSlides.length > 1 && (
      <div class="hero-dots" role="tablist" aria-label="Imágenes del inicio">
        {heroSlides.map((_, i) => (
          <button type="button" class={i === 0 ? 'is-active' : ''} aria-label={`Ver imagen ${i + 1}`} data-slide={i}></button>
        ))}
      </div>
    )}
  </section>

  <script>
    const hero = document.getElementById('hero') as HTMLElement;
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('.hero-slide'));
    const dots = Array.from(hero.querySelectorAll<HTMLElement>('.hero-dots button'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;
    let cleanup: number | undefined;

    const go = (n: number) => {
      n = (n + slides.length) % slides.length;
      if (n === current) return;
      slides.forEach((s) => s.classList.remove('is-prev'));
      slides[current].classList.remove('is-active');
      slides[current].classList.add('is-prev');
      slides[n].classList.add('is-active');
      dots[current]?.classList.remove('is-active');
      dots[n]?.classList.add('is-active');
      current = n;
      window.clearTimeout(cleanup);
      cleanup = window.setTimeout(() => slides.forEach((s) => s.classList.remove('is-prev')), 1600);
    };
    const play = () => {
      window.clearInterval(timer);
      if (slides.length > 1 && !reduce) timer = window.setInterval(() => go(current + 1), 6500);
    };
    dots.forEach((d, i) => d.addEventListener('click', () => { go(i); play(); }));
    hero.addEventListener('mouseenter', () => window.clearInterval(timer));
    hero.addEventListener('mouseleave', play);
    play();
  </script>

  <!-- QUIEN SOY -->
  <section class="section">
    <div class="container grid-2">
      <div data-reveal>
        <span class="eyebrow">Quién soy</span>
        <h2>{site.doctorName}</h2>
        <p class="lede">{site.specialty}.</p>
        <p>
          Médico ginecólogo graduado de la Universidad de Cuenca, con subespecialidad en
          Biología de la Reproducción Humana por la Universidad Nacional Autónoma de
          México (UNAM) y alta especialidad en Cirugía Endoscópica Ginecológica por la
          Universidad San Nicolás de Hidalgo (México). Cuenta con diplomado en
          colposcopia y capacitación en cirugía robótica.
        </p>
        <p>Profesor del postgrado de la Universidad de Cuenca.</p>
        <h3 class="member-title">Miembro de</h3>
        <ul class="members">
          <li><strong>ESHRE</strong> Sociedad Europea de Medicina de la Reproducción</li>
          <li><strong>ASRM</strong> Sociedad Americana de Medicina de la Reproducción</li>
          <li><strong>AMMR</strong> Asociación Mexicana de Medicina de la Reproducción</li>
        </ul>
        <a class="btn btn--ghost" href="/nosotros">Conocer más sobre nosotros</a>
      </div>
      <div class="panel" data-reveal>
        <h3>Horario de atención</h3>
        <ul class="hours-list">
          {site.hours.map((h) => (
            <li><span>{h.day}</span><span>{h.time}</span></li>
          ))}
        </ul>
        {site.hoursNote && <p class="hours-note">{site.hoursNote}</p>}
        <hr class="divider" />
        <h3>Ubicación</h3>
        <p>{site.address.line1}<br />{site.address.city}</p>
        <a href={site.address.mapsUrl} target="_blank" rel="noopener">Ver en el mapa →</a>
      </div>
    </div>
  </section>

  <!-- INSTALACIONES (foto) -->
  <section class="section section--soft">
    <div class="container facility-grid">
      <RealPhoto src="/images/team/clinic-entrance.jpg" alt="Entrada del consultorio" aspect="wide" caption="Nuestras instalaciones en Cuenca" />
      <div data-reveal>
        <span class="eyebrow">Instalaciones</span>
        <h2>Un espacio pensado para tu tranquilidad</h2>
        <p class="lede">
          Consultorios, quirófano y laboratorio de reproducción asistida,
          diseñados para que cada visita sea cómoda y privada.
        </p>
        <a class="btn btn--ghost" href="/nosotros#instalaciones">Ver instalaciones →</a>
      </div>
    </div>
  </section>

  <!-- AREAS DE SERVICIO (con íconos) -->
  <AreaCards />

  <!-- CIFRAS -->
  <HomeStats />

  <!-- CAMINO DEL PACIENTE -->
  <HomeProcess />

  <!-- LABORATORIO -->
  <LabGallery variant="compact" />

  <!-- EQUIPO ASOCIADO -->
  <HomeTeam />

  <!-- PREGUNTAS FRECUENTES -->
  <HomeFaq />

  <!-- CONTACTO / AGENDAR CITA -->
  <HomeContact />

</Layout>

<style>
  .hero {
    position: relative;
    min-height: min(84vh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #FBFDFD;
    background: #1E1B48;
  }
  .hero-bg { position: absolute; inset: 0; z-index: 0; }
  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 32%;
    opacity: 0;
    transition: opacity 1400ms ease;
  }
  .hero-slide.is-prev { opacity: 1; z-index: 1; }
  .hero-slide.is-active { opacity: 1; z-index: 2; animation: heroZoom 14s ease-out both; }
  @keyframes heroZoom { from { transform: scale(1.07); } to { transform: scale(1); } }

  .hero-slide--fallback {
    background:
      radial-gradient(circle at 76% 52%, rgba(144,207,213,.5) 0%, rgba(91,190,197,.24) 26%, transparent 58%),
      linear-gradient(118deg, #1E1B48 0%, #29265B 52%, #2B5B86 100%);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: linear-gradient(96deg, rgba(30,27,72,.92) 0%, rgba(35,32,80,.78) 36%, rgba(41,38,91,.28) 68%, rgba(41,38,91,.12) 100%);
  }

  .hero-content { position: relative; z-index: 4; padding-top: 80px; padding-bottom: 110px; }
  .hero-copy { max-width: 640px; animation: heroFade 1100ms ease-out both; }
  @keyframes heroFade { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .hero .eyebrow { color: var(--teal-light); }
  .hero h1 {
    color: #FFFFFF;
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    letter-spacing: -0.015em;
  }
  .hero .lede { color: #DCEFF1; }
  .hero-actions { display: flex; gap: 14px; margin-top: 10px; flex-wrap: wrap; }

  .hero-dots {
    position: absolute;
    left: 50%;
    bottom: 30px;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    gap: 10px;
  }
  .hero-dots button {
    width: 10px;
    height: 10px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255,255,255,.45);
    cursor: pointer;
    transition: background-color 250ms ease, transform 250ms ease;
  }
  .hero-dots button.is-active { background: #fff; transform: scale(1.35); }

  .member-title { margin-top: 1.4em; font-size: 1.05rem; }
  .members { list-style: none; padding: 0; margin: 0 0 1.4em; }
  .members li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 8px 0;
    border-top: 1px solid var(--line);
    font-size: 0.93rem;
    color: var(--ink-soft);
  }
  .members li strong {
    min-width: 58px;
    font-family: var(--font-display);
    color: var(--teal-dark);
    font-size: 1.05rem;
  }

  .facility-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .hours-list { list-style: none; padding: 0; margin: 0 0 1em; }
  .hours-list li { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; font-size: 0.95rem; }
  .hours-list li span:first-child { color: var(--ink-soft); }
  .hours-note { margin: -0.3em 0 1em; font-size: 0.85rem; font-style: italic; color: var(--ink-soft); }

  @media (max-width: 900px) {
    .hero { min-height: 640px; }
    .hero-slide { background-position: var(--mpos, 75% center); }
    .hero-content { padding-top: 56px; padding-bottom: 120px; }
    .hero-overlay { background: linear-gradient(180deg, rgba(30,27,72,.9) 0%, rgba(35,32,80,.72) 55%, rgba(41,38,91,.5) 100%); }
    .facility-grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
