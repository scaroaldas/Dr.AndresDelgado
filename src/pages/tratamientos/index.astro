---
import Layout from '../../layouts/Layout.astro';
import { site, whatsappLink } from '../../data/site.js';
import { tratamientos, categorias } from '../../data/tratamientos.js';

const grupos = categorias.map((nombre) => ({ nombre, items: tratamientos.filter((t) => t.categoria === nombre) }));
const origin = (Astro.site ?? Astro.url).origin;
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Tratamientos de fertilidad y ginecología en Cuenca',
    url: `${origin}/tratamientos`,
    inLanguage: 'es-EC',
  },
  {
    '@type': 'ItemList',
    itemListElement: tratamientos.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.nombre,
      url: `${origin}/tratamientos/${t.slug}`,
    })),
  },
];
---
<Layout
  title="Tratamientos de fertilidad y ginecología en Cuenca | Dr. Andrés Delgado"
  description="Inseminación artificial, FIV, ICSI, vitrificación de óvulos, ovodonación, histeroscopia y más. Conoce cada tratamiento y cómo es el proceso. Cuenca, Ecuador."
  jsonLd={jsonLd}
>
  <section class="section th-hero">
    <div class="container" data-reveal>
      <span class="eyebrow">Tratamientos</span>
      <h1>Tratamientos de fertilidad y ginecología en Cuenca</h1>
      <p class="lede">
        Explica cada tratamiento con claridad: qué es, para quién está indicado, cómo es el proceso paso a paso y qué
        debes considerar antes de decidir. La mejor opción para ti se define en consulta.
      </p>
      <a class="btn btn--whatsapp" href={whatsappLink('Hola, quisiera orientación sobre los tratamientos de fertilidad.')} target="_blank" rel="noopener">Pedir orientación por WhatsApp</a>
    </div>
  </section>

  {grupos.map((g, idx) => (
    <section class={`section${idx % 2 === 1 ? ' section--soft' : ''}`}>
      <div class="container">
        <h2>{g.nombre}</h2>
        <div class="th-grid" data-reveal-group>
          {g.items.map((t) => (
            <a class="th-card" href={`/tratamientos/${t.slug}`}>
              <span class="th-card__img"><img src={t.foto.src} alt={t.foto.alt} loading="lazy" style={`object-position:${t.foto.pos}`} /></span>
              <span class="th-card__body">
                <h3>{t.nombre}</h3>
                <p>{t.corto}</p>
                <span class="th-card__more">Ver tratamiento →</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
</Layout>

<style>
  .th-hero { padding-top: 52px; padding-bottom: 40px; border-bottom: 1px solid var(--line); }
  .th-hero .lede { margin-bottom: 22px; }
  .th-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 26px; }
  .th-card { display: block; text-decoration: none; color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--white); transition: transform 220ms ease, box-shadow 220ms ease; }
  .th-card:hover { transform: translateY(-4px); box-shadow: 0 18px 30px -20px rgba(41, 38, 91, 0.35); }
  .th-card__img { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg-soft); }
  .th-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1); }
  .th-card:hover .th-card__img img { transform: scale(1.05); }
  .th-card__body { display: block; padding: 22px 22px 20px; }
  .th-card h3 { margin: 0 0 0.35em; font-size: 1.15rem; color: var(--teal-dark); }
  .th-card p { margin: 0 0 12px; font-size: 0.92rem; color: var(--ink-soft); }
  .th-card__more { font-size: 0.88rem; font-weight: 600; color: var(--teal); }
  @media (max-width: 900px) { .th-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .th-grid { grid-template-columns: 1fr; } }
</style>
