---
import Layout from '../layouts/Layout.astro';
import RealPhoto from '../components/RealPhoto.astro';
import ReviewCta from '../components/ReviewCta.astro';
import { site, whatsappLink, googleReadLink } from '../data/site.js';

// Las reseñas se escriben en Google (no aquí). Cuando haya reseñas reales, cópialas en
// "resenas" y la calificación en "googleRating" dentro de src/data/site.js.
const resenas = site.resenas ?? [];
const rating = site.googleRating;
const estrellas = (n = 5) => '★'.repeat(n) + '☆'.repeat(5 - n);
---
<Layout title={`Testimonios — ${site.doctorName}`} description="Historias de pacientes que han confiado en nosotros.">

  <section class="section page-hero">
    <div class="container hero-split">
      <div data-reveal>
        <span class="eyebrow">Testimonios</span>
        <h1>Tu experiencia ayuda a otras familias</h1>
        <p class="lede">
          Las opiniones de nuestras pacientes viven en Google, para que cualquiera pueda
          verlas y confiar. Si te atendimos, cuéntanos cómo te fue.
        </p>
        {rating && (
          <p class="rating-line">
            <strong>{rating.valor}</strong> <span class="stars" aria-hidden="true">{estrellas(Math.round(rating.valor))}</span>
            <a href={googleReadLink()} target="_blank" rel="noopener">{rating.total} reseñas en Google</a>
          </p>
        )}
      </div>
      <RealPhoto src="/images/team/consult-model.jpg" alt="Consulta con una paciente" aspect="square" focal="50% 20%" />
    </div>
  </section>

  <section class="section section--lilac">
    <div class="container">
      <ReviewCta />
      <ol class="how" data-reveal-group>
        <li><strong>1</strong><span>Toca <em>Calificar en Google</em>.</span></li>
        <li><strong>2</strong><span>Elige tus estrellas e inicia sesión con tu cuenta de Google.</span></li>
        <li><strong>3</strong><span>Escribe unas líneas sobre tu experiencia y publica.</span></li>
      </ol>
    </div>
  </section>

  {resenas.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">Lo que dicen en Google</span>
        <h2>Reseñas de pacientes</h2>
        <div class="testi-grid" data-reveal-group>
          {resenas.map((t) => (
            <div class="testi-card">
              <p class="stars" aria-label={`${t.estrellas ?? 5} de 5 estrellas`}>{estrellas(t.estrellas ?? 5)}</p>
              <p class="testi-quote">{t.texto}</p>
              <p class="testi-name">{t.nombre}{t.fecha ? ` · ${t.fecha}` : ''}</p>
            </div>
          ))}
        </div>
        <p class="more"><a href={googleReadLink()} target="_blank" rel="noopener">Ver todas las reseñas en Google →</a></p>
      </div>
    </section>
  )}

  <section class="section section--teal cta">
    <div class="container cta-inner">
      <div>
        <h2>Queremos acompañarte también a ti</h2>
        <p>Escríbenos y conversemos sobre tu situación particular.</p>
      </div>
      <a class="btn btn--whatsapp" href={whatsappLink()} target="_blank" rel="noopener">Escribir por WhatsApp</a>
    </div>
  </section>

</Layout>

<style>
  .page-hero { padding-top: 52px; padding-bottom: 40px; border-bottom: 1px solid var(--line); }
  .hero-split { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 48px; align-items: center; }
  .stars { color: #E4B94C; letter-spacing: 2px; margin: 0; }
  .rating-line { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 18px; }
  .rating-line strong { font-family: var(--font-display); font-size: 2rem; color: var(--teal-dark); line-height: 1; }
  .rating-line a { color: var(--rose-dark); font-weight: 600; }

  .how { list-style: none; margin: 34px auto 0; padding: 0; max-width: 720px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .how li { display: flex; gap: 12px; align-items: flex-start; font-size: 0.95rem; color: var(--ink); }
  .how strong { flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; background: var(--lilac); color: var(--teal-dark); display: grid; place-items: center; font-family: var(--font-display); }

  .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 24px; }
  .testi-card { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 26px; transition: transform 220ms ease; }
  .testi-card:hover { transform: translateY(-4px); }
  .testi-quote { font-family: var(--font-display); font-style: italic; font-size: 1.05rem; color: var(--ink); margin: 10px 0 14px; }
  .testi-name { color: var(--rose-dark); font-weight: 600; font-size: 0.9rem; margin: 0; }
  .more { margin-top: 24px; }
  .more a { color: var(--rose-dark); font-weight: 600; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .testi-grid { grid-template-columns: 1fr; }
    .hero-split { grid-template-columns: 1fr; }
    .how { grid-template-columns: 1fr; }
  }
</style>
